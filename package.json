{
  "name": "universal-arranger-os",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "description": "Universal Arranger OS desktop workstation",
  "author": "Sarey Raslan",
  "scripts": {
    "dev": "concurrently \"cd backend && node src/server.js\" \"cd frontend && npm run dev\"",
    "frontend:install": "cd frontend && npm install",
    "frontend:build": "cd frontend && npm run build",
    "desktop:start": "electron electron/main.cjs",
    "desktop:build": "npm run frontend:build && electron-builder",
    "release:win": "npm run frontend:build && electron-builder --win nsis portable",
    "release:portable": "npm run frontend:build && electron-builder --win portable",
    "release:nsis": "npm run frontend:build && electron-builder --win nsis",
    "prod:start": "powershell -ExecutionPolicy Bypass -File scripts/production/start-production.ps1",
    "prod:stop": "powershell -ExecutionPolicy Bypass -File scripts/production/stop-production.ps1",
    "prod:health": "powershell -ExecutionPolicy Bypass -File scripts/production/health-production.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.universalarranger.os",
    "productName": "Universal Arranger OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Universal Arranger OS"
    }
  }
}
