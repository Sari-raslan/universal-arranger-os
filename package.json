{
    "name":  "universal-arranger-os",
    "version":  "11.2.0",
    "private":  true,
    "main":  "electron/main.js",
    "scripts":  {
                    "setup":  "npm install --prefix backend \u0026\u0026 npm install --prefix uaos-live-clean",
                    "build":  "npm run build --prefix uaos-live-clean",
                    "dev":  "node backend/server.js",
                    "front":  "npm run preview --prefix uaos-live-clean",
                    "test":  "node --test tests/*.test.mjs tests/*.test.js tests/*.test.cjs",
                    "check":  "node scripts/uaos-static-check.mjs \u0026\u0026 npm test",
                    "desktop":  "npm start --prefix desktop",
                    "desktop:smoke":  "node scripts/uaos-desktop-smoke.mjs",
                    "master":  "powershell -ExecutionPolicy Bypass -File scripts/UAOS_MASTER_REMAINING_ALL_IN_ONE.ps1",
                    "electron:dev":  "set UAOS_DEV_URL=http://127.0.0.1:5173\u0026\u0026 electron .",
                    "electron:start":  "electron .",
                    "runtime:check":  "node scripts/uaos-runtime-check.mjs",
                    "runtime:start":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/UAOS_RUNTIME_START.ps1",
                    "pack:win":  "npm run build \u0026\u0026 electron-builder --win --dir --publish never",
                    "dist:win:setup":  "npm run build \u0026\u0026 electron-builder --win nsis --publish never",
                    "dist:win:portable":  "npm run build \u0026\u0026 electron-builder --win portable --publish never"
                },
    "type":  "module",
    "devDependencies":  {
                            "electron":  "^42.4.0",
                            "electron-builder":  "^26.15.3"
                        },
    "dependencies":  {
                         "electron-updater":  "^6.6.2",
                         "express":  "^5.2.1",
                         "nodemailer":  "^9.0.0"
                     }
}
