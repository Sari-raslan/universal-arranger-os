{
  "name": "universal-arranger-os",
  "version": "11.2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "setup": "npm install --prefix backend && npm install --prefix uaos-live-clean",
    "build": "npm run build --prefix uaos-live-clean",
    "dev": "node backend/server.js",
    "front": "npm run preview --prefix uaos-live-clean",
    "test": "node --test tests/*.test.mjs tests/*.test.js tests/*.test.cjs",
    "ai:factory:check": "node scripts/uaos-ai-factory-safety-check.mjs",
    "ai:factory:status": "node scripts/uaos-ai-factory-status.mjs",
    "ai:factory:next": "node scripts/uaos-ai-factory-next-task.mjs",
    "ai:factory:daily": "node scripts/uaos-ai-factory-daily-report.mjs",
    "ai:factory:cost": "node scripts/uaos-ai-factory-cost-guard.mjs",
    "ai:factory:packet": "node scripts/uaos-ai-factory-agent-packet.mjs",
    "ai:factory:review": "node scripts/uaos-ai-factory-review-preview.mjs",
    "ai:factory:dry-run": "node scripts/uaos-ai-factory-dry-run.mjs",
    "ai:factory:identity": "node scripts/uaos-ai-factory-platform-identity-check.mjs",
    "ai:factory:vercel-plan": "node scripts/uaos-ai-factory-vercel-plan-check.mjs",
    "ai:factory:linear-plan": "node scripts/uaos-ai-factory-linear-plan-check.mjs",
    "ai:factory:github-plan": "node scripts/uaos-ai-factory-github-plan-check.mjs",
    "ai:factory:copilot-plan": "node scripts/uaos-ai-factory-copilot-plan-check.mjs",
    "ai:factory:qa-plan": "node scripts/uaos-ai-factory-qa-plan-check.mjs",
    "ai:factory:premium-plan": "node scripts/uaos-ai-factory-premium-library-plan-check.mjs",
    "check": "node scripts/uaos-static-check.mjs && npm test",
    "desktop": "npm start --prefix desktop",
    "desktop:smoke": "node scripts/uaos-desktop-smoke.mjs",
    "master": "powershell -ExecutionPolicy Bypass -File scripts/UAOS_MASTER_REMAINING_ALL_IN_ONE.ps1",
    "electron:dev": "set UAOS_DEV_URL=http://127.0.0.1:5173&& electron .",
    "electron:start": "electron .",
    "runtime:check": "node scripts/uaos-runtime-check.mjs",
    "runtime:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/UAOS_RUNTIME_START.ps1",
    "pack:win": "npm run build && electron-builder --win --dir --publish never",
    "dist:win:setup": "npm run build && electron-builder --win nsis --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "type": "module",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "nodemailer": "^9.0.0"
  }
}
