{
  "schema": "uaos.commander-command/v1",
  "type": "object",
  "required": [
    "commandId",
    "command",
    "at"
  ],
  "properties": {
    "command": {
      "enum": [
        "listTasks",
        "claimTask",
        "renewLease",
        "reportHeartbeat",
