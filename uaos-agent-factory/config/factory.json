  "artifactRoot": "D:/UAOS_AGENT_FACTORY_ARTIFACTS",
  "buildCacheRoot": "C:/UAOS_AGENT_FACTORY_BUILD",
  "dashboardHost": "127.0.0.1",
  "dashboardPort": 17321,
  "resourcePolicy": {
    "ramFreeGe12": { "maxHeavyWriters": 3, "maxLightReviewers": 3 },
    "ramFreeGe7": { "maxHeavyWriters": 2, "maxLightReviewers": 2 },
    "ramFreeGe4": { "maxHeavyWriters": 1, "maxLightReviewers": 2 },
    "ramFreeLt4": { "maxHeavyWriters": 0, "maxLightReviewers": 1, "pauseHeavy": true },
    "diskMinGb": { "C": 10, "D": 25, "E": 10 },
    "diskCriticalGb": 2
  },
  "lanePriority": { "singy": 45, "arranger": 35, "library": 20 },
  "lanes": {
    "singy": {
      "repoRoot": "E:/keyboard-manager-clean/uaos-worktrees/uaos-singy-final-product",
      "integrationBranch": "factory/singy-integration",
      "productName": "UAOS Singy"
    },
    "arranger": {
      "repoRoot": "E:/keyboard-manager-clean/uaos-real-product",
      "integrationBranch": "factory/arranger-integration",
      "productName": "UAOS Arranger Studio"
    },
    "library": {
      "repoRoot": "E:/keyboard-manager-clean/uaos-real-product",
      "integrationBranch": "factory/library-integration",
      "productName": "UAOS Library Factory Studio",
      "note": "Shares uaos-real-product source; isolated via factory worktrees and path allowlists"
    }
  },
  "forbiddenCommands": [
    "git push",
    "gh release",
    "npm publish",
    "vercel deploy",
    "netlify deploy",
    "firebase deploy",
    "git reset --hard",
    "git clean -fd",
    "git stash"
