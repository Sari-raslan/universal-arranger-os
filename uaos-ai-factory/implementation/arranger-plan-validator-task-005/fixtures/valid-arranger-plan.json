      "bars": 16,
      "chords": ["Dm", "Eb", "A"],
      "instruments": ["oriental-strings", "bass", "soft-percussion"],
      "role": "state main motif"
    },
    {
      "name": "chorus",
      "bars": 16,
      "harmonicPlan": ["i", "iv", "bII", "v"],
      "instruments": ["oriental-strings", "strings", "percussion"],
      "role": "raise emotional energy"
    },
    {
      "name": "fill",
      "bars": 2,
      "chords": ["A"],
      "instruments": ["percussion"],
      "role": "transition marker"
    },
    {
      "name": "ending",
      "bars": 8,
      "harmonicPlan": ["i", "v", "i"],
      "instruments": ["oriental-strings", "pads"],
      "role": "resolve phrase"
