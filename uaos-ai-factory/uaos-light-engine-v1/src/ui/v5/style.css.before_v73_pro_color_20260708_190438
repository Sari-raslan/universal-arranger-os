*{box-sizing:border-box}
body{margin:0;background:#0b1220;color:#fff;font-family:Segoe UI,Tahoma,Arial,sans-serif}
.app{max-width:980px;margin:0 auto;padding:22px}
header{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:24px}
h1{font-size:44px;margin:0;letter-spacing:-1px}
p{margin:6px 0 0;color:#b9c6d8;font-size:18px}
.pill{padding:10px 14px;border-radius:999px;background:#23314d;color:#d7e5ff;font-weight:700}
.hero{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px}
.status-card{background:#121d33;border:1px solid #243655;border-radius:20px;padding:20px}
.status-card span{display:block;color:#95a3ba;margin-bottom:8px}
.status-card strong{font-size:28px}
.buttons{display:grid;grid-template-columns:repeat(2,minmax(160px,1fr));gap:14px}
button{border:0;border-radius:18px;padding:22px;font-size:20px;font-weight:800;background:#2563eb;color:#fff;cursor:pointer;box-shadow:0 12px 30px rgba(0,0,0,.22)}
button:hover{filter:brightness(1.12)}
button.danger{background:#dc2626}
.panel{margin-top:18px;padding:20px;border-radius:20px;background:#121d33;border:1px solid #243655}
.hidden{display:none}
.favgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
input[type=range]{width:100%;margin:10px 0 18px}
details{margin:16px 0;padding:14px;border-radius:14px;background:#0b1220}
footer{margin-top:22px;color:#7f8da3;text-align:center}
@media(max-width:640px){.hero,.buttons{grid-template-columns:1fr}h1{font-size:34px}header{align-items:flex-start;flex-direction:column}}
button.off{background:#111827;border:1px solid #60a5fa;color:#e0f2fe}


button.whiteMode{
  background:#f8fafc;
  color:#0f172a;
  border:1px solid #dbeafe;
}
button.yellowMode{
  background:#facc15;
  color:#1f2937;
}
button.nightMode{
  background:#1e3a8a;
  color:#dbeafe;
}
button.sleepMode{
  background:#312e81;
  color:#ede9fe;
}
/* UAOS V7.1 Smart Beautiful UI */
body{
  background:
    radial-gradient(circle at 20% 10%, rgba(37,99,235,.28), transparent 35%),
    radial-gradient(circle at 80% 20%, rgba(168,85,247,.18), transparent 28%),
    linear-gradient(135deg,#050816,#0b1220 45%,#111827);
}

.app{
  max-width:1040px;
}

header{
  padding:18px 0;
}

h1{
  text-shadow:0 8px 30px rgba(59,130,246,.28);
}

.pill{
  background:linear-gradient(135deg,#14532d,#0f766e);
  color:#dcfce7;
  box-shadow:0 0 24px rgba(34,197,94,.22);
}

.status-card{
  background:linear-gradient(180deg,rgba(15,23,42,.92),rgba(17,24,39,.9));
  border:1px solid rgba(96,165,250,.45);
  box-shadow:0 18px 45px rgba(0,0,0,.28);
}

.buttons button{
  background:linear-gradient(135deg,#1d4ed8,#2563eb);
  border:1px solid rgba(147,197,253,.25);
}

.buttons button:hover{
  transform:translateY(-1px);
  box-shadow:0 16px 38px rgba(37,99,235,.28);
}

button.danger{
  background:linear-gradient(135deg,#991b1b,#dc2626);
}

button.off{
  background:linear-gradient(135deg,#020617,#111827);
  border:1px solid #38bdf8;
  color:#e0f2fe;
}

.smart-card{
  margin-top:20px;
  padding:20px;
  border-radius:24px;
  background:linear-gradient(180deg,rgba(15,23,42,.94),rgba(2,6,23,.94));
  border:1px solid rgba(148,163,184,.25);
  box-shadow:0 18px 45px rgba(0,0,0,.22);
}

.section-title{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:12px;
  margin-bottom:14px;
}

.section-title span{
  font-size:24px;
  font-weight:900;
}

.section-title small{
  color:#94a3b8;
}

.filter-grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:12px;
}

button.filter{
  font-size:17px;
  padding:18px 12px;
  border-radius:18px;
}

button.candle{
  background:linear-gradient(135deg,#78350f,#f59e0b);
}

button.fire{
  background:linear-gradient(135deg,#7f1d1d,#f97316);
}

button.sunset{
  background:linear-gradient(135deg,#be123c,#f59e0b);
}

button.ocean{
  background:linear-gradient(135deg,#0f172a,#0284c7);
}

button.warm{
  background:linear-gradient(135deg,#92400e,#fde047);
  color:#1f2937;
}

@media(max-width:760px){
  .filter-grid{grid-template-columns:1fr 1fr}
}
/* UAOS_FINAL_DAILY_READY_UI_V72 */
header{
  background:rgba(15,23,42,.35);
  border:1px solid rgba(148,163,184,.14);
  border-radius:28px;
  padding:22px;
  backdrop-filter:blur(10px);
}

header h1::after{
  content:"";
  display:block;
  width:96px;
  height:4px;
  margin-top:10px;
  border-radius:999px;
  background:linear-gradient(90deg,#38bdf8,#a78bfa,#facc15);
}

.buttons{
  margin-bottom:10px;
}

.buttons button,
.filter-grid button{
  min-height:72px;
}

.daily-presets .filter-grid,
.mood-presets .filter-grid{
  grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
}

button.preset{
  font-size:18px;
}

button.romantic{
  background:linear-gradient(135deg,#9d174d,#f472b6);
}
button.cinema{
  background:linear-gradient(135deg,#020617,#475569);
}
button.reading{
  background:linear-gradient(135deg,#78350f,#fbbf24);
  color:#1f2937;
}
button.focus{
  background:linear-gradient(135deg,#064e3b,#14b8a6);
}
button.blueSoft{
  background:linear-gradient(135deg,#172554,#38bdf8);
}
button.purpleRoom{
  background:linear-gradient(135deg,#312e81,#a78bfa);
}
button.sunrise{
  background:linear-gradient(135deg,#fb7185,#fbbf24);
  color:#1f2937;
}
button.goldRoom{
  background:linear-gradient(135deg,#854d0e,#fde047);
  color:#1f2937;
}

footer{
  padding:18px;
  border-radius:18px;
  background:rgba(15,23,42,.45);
  border:1px solid rgba(148,163,184,.14);
}
/* UAOS_TEXT_CLEANUP_V73 */
.section-title small{
  font-family:Segoe UI,Tahoma,Arial,sans-serif;
  direction:ltr;
  unicode-bidi:normal;
  color:#9ca3af;
}

button.filter,
button.preset{
  font-family:Segoe UI,Tahoma,Arial,sans-serif;
  letter-spacing:.1px;
}

footer{
  font-family:Segoe UI,Tahoma,Arial,sans-serif;
  direction:ltr;
  unicode-bidi:normal;
}

.smart-card{
  overflow:hidden;
}
