{
  "targetExtensions": [
    ".prf"
  ],
  "maxBytesPerFileRead": 16384,
  "structuralCatalogueOnly": true,
  "noFullFileDecode": true,
  "noValueDecode": true,
  "noMusicalMeaning": true,
  "noFixtureWrite": true,
  "noKeyboardOutput": true,
  "noGeneratedKeyboardFiles": [
    ".SET",
    ".STY",
    ".PRS",
    ".PRF",
    ".KST"
  ]
}
