{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uaos-project-workspace-pack.schema.json",
  "title": "UAOS Project Workspace Pack",
  "type": "object",
  "required": ["format", "version", "slots", "qaManifest", "savePolicy", "safety"],
  "properties": {
    "format": { "const": "UAOS_PROJECT_WORKSPACE_PACK" },
    "version": { "type": "string" },
    "title": { "type": "string" },
    "projectState": { "const": "local-safe-workspace" },
    "slots": {
      "type": "object",
      "required": ["libraryIndex", "samplerPresetPack", "dawTrackTemplateSet", "arrangementProject", "exports"]
    },
    "qaManifest": {
      "type": "object",
      "required": ["format", "checks", "summary"],
      "properties": {
        "format": { "const": "UAOS_WORKSPACE_QA_MANIFEST" },
        "checks": { "type": "array" },
        "summary": { "type": "object" }
      }
    },
    "savePolicy": {
      "type": "object",
      "required": ["localJsonOnly", "browserDownloadAllowed", "serverWrite", "cloudSync", "deploy"],
      "properties": {
        "localJsonOnly": { "const": true },
        "browserDownloadAllowed": { "const": true },
        "serverWrite": { "const": false },
        "cloudSync": { "const": false },
        "deploy": { "const": false }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "metadataOnly",
        "fileContentRead",
        "sampleLoaded",
        "audioDecoded",
        "audioRendered",
        "midiExported",
        "copiedFiles",
        "movedFiles",
        "deletedFiles",
        "archiveRead",
        "productionParser",
        "keyboardWriter",
        "keyboardOutput",
        "deploy"
      ],
      "properties": {
        "metadataOnly": { "const": true },
        "fileContentRead": { "const": false },
        "sampleLoaded": { "const": false },
        "audioDecoded": { "const": false },
        "audioRendered": { "const": false },
        "midiExported": { "const": false },
        "copiedFiles": { "const": false },
        "movedFiles": { "const": false },
        "deletedFiles": { "const": false },
        "archiveRead": { "const": false },
        "productionParser": { "const": false },
        "keyboardWriter": { "const": false },
        "keyboardOutput": { "const": false },
        "deploy": { "const": false }
      }
    }
  }
}
