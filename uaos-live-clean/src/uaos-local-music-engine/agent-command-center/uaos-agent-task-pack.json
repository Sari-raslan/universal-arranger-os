{
  "format": "UAOS_AGENT_TASK_PACK",
  "version": "1.0.0-safe-local",
  "status": "ready-for-human-or-agent-review",
  "executionPolicy": {
    "autoExecuteUnknownAgents": false,
    "deleteFiles": false,
    "deploy": false,
    "touchAppJs": false,
    "productionParser": false,
    "keyboardWriter": false,
    "keyboardOutput": false
  },
  "agents": [
    {
      "agentId": "qa-agent",
      "title": "QA Agent",
      "tasks": [
        "Run node scripts/qa/verify-local-music-engine-all.mjs",
        "Run node scripts/qa/final-local-music-engine-gate.mjs",
        "Report failures only with command and last 30 lines"
      ]
    },
    {
      "agentId": "scanner-agent",
      "title": "Scanner Agent",
      "tasks": [
        "Use Real Limited Scanner v1 only with approval JSON and explicit flag",
        "Generate metadata-only scanner report",
        "Do not read file contents"
      ]
    },
    {
      "agentId": "pipeline-agent",
      "title": "Pipeline Agent",
      "tasks": [
        "Import scanner report into pipeline",
        "Generate final workspace JSON",
        "Run import QA"
      ]
    },
    {
      "agentId": "docs-agent",
      "title": "Docs Agent",
      "tasks": [
        "Update local documentation",
        "Keep status honest: safe local prototype only",
        "List locked production items"
      ]
    }
  ]
}
